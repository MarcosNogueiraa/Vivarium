# Copiar pra deploy/.env (não commitado) e preencher antes de "docker compose up".

# Connection string do Neon (mesma que você usa localmente via user-secrets).
CONNECTIONSTRINGS__VIVARIUM=Host=...;Database=vivarium;Username=...;Password=...;Ssl Mode=Require

# Chave forte NOVA pra produção — NÃO reusar a de dev/local. Gerar com:
#   openssl rand -base64 48
JWT__KEY=

# Subdomínio DuckDNS que aponta pro IP público (reservado) da VM do Oracle.
# Caddy usa isso pra emitir o certificado Let's Encrypt automaticamente.
API_DOMAIN=vivarium.duckdns.org

# URL do frontend publicado no Cloudflare Pages (sem "https://", só o host) —
# usada para montar a origem permitida em Cors__AllowedOrigins__0.
FRONTEND_DOMAIN=seu-projeto.pages.dev

# IMPORTANTE: NÃO setar ASPNETCORE_ENVIRONMENT=Development em produção —
# isso exporia os endpoints /api/dev/* (gerar/limpar peixe) publicamente.
# Sem essa variável, o padrão do container já é Production.
